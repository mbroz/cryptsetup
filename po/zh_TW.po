#: lib/libdevmapper.c:422
msgid "Cannot initialize device-mapper, running as non-root user."
msgstr "無法初始化 device-mapper，目前是以非 root 使用者身分執行。"

#: lib/libdevmapper.c:425
msgid "Cannot initialize device-mapper. Is dm_mod kernel module loaded?"
msgstr "無法初始化 device-mapper。核心模組 dm_mod 有載入嗎？"

#: lib/libdevmapper.c:1129
msgid "Requested deferred flag is not supported."
msgstr "要求的 deferred 旗標不受支援。"

#: lib/libdevmapper.c:1198
#, c-format
msgid "DM-UUID for device %s was truncated."
msgstr "裝置 %s 的 DM-UUID 遭到截斷。"

#: lib/libdevmapper.c:1602
msgid "Unknown dm target type."
msgstr "未知的 dm target 類型。"

#: lib/libdevmapper.c:1729 lib/libdevmapper.c:1735 lib/libdevmapper.c:1854
#: lib/libdevmapper.c:1857
msgid "Requested dm-crypt performance options are not supported."
msgstr "要求的 dm-crypt 效能選項不受支援。"

#: lib/libdevmapper.c:1744 lib/libdevmapper.c:1750 lib/libdevmapper.c:1762
msgid "Requested dm-verity data corruption handling options are not supported."
msgstr "要求的 dm-verity 資料毀損處理選項不受支援。"

#: lib/libdevmapper.c:1756
msgid "Requested dm-verity tasklets option is not supported."
msgstr "要求的 dm-verity tasklets 選項不受支援。"

#: lib/libdevmapper.c:1768
msgid "Requested dm-verity FEC options are not supported."
msgstr "要求的 dm-verity FEC 選項不受支援。"

#: lib/libdevmapper.c:1774
msgid "Requested data integrity options are not supported."
msgstr "要求的資料完整性選項不受支援。"

#: lib/libdevmapper.c:1778
msgid "Requested sector_size option is not supported."
msgstr "要求的 sector_size 選項不受支援。"

#: lib/libdevmapper.c:1783
msgid "The device size is not multiple of the requested sector size."
msgstr "裝置大小不是所要求磁區大小的倍數。"

#: lib/libdevmapper.c:1787
msgid "Requested integrity_key_size option is not supported."
msgstr "要求的 integrity_key_size 選項不受支援。"

#: lib/libdevmapper.c:1794 lib/libdevmapper.c:1800
msgid "Requested automatic recalculation of integrity tags is not supported."
msgstr "要求的完整性標籤自動重新計算不受支援。"

#: lib/libdevmapper.c:1806 lib/libdevmapper.c:1860 lib/libdevmapper.c:1863
#: lib/luks2/luks2_json_metadata.c:2791
msgid "Discard/TRIM is not supported."
msgstr "不支援 Discard/TRIM。"

#: lib/libdevmapper.c:1812
msgid "Requested dm-integrity bitmap mode is not supported."
msgstr "要求的 dm-integrity 點陣圖模式不受支援。"

#: lib/libdevmapper.c:1818
msgid "Requested dm-integrity inline mode is not supported."
msgstr "要求的 dm-integrity inline 模式不受支援。"

#: lib/libdevmapper.c:2877
#, c-format
msgid "Failed to query dm-%s segment."
msgstr "無法查詢 dm-%s 區段。"

#: lib/random.c:60
msgid ""
"System is out of entropy while generating volume key.\n"
"Please move mouse or type some text in another window to gather some random events.\n"
msgstr ""
"產生卷金鑰時系統熵不足。\n"
"請移動滑鼠或在其他視窗輸入一些文字，以收集隨機事件。\n"

#: lib/random.c:64
#, c-format
msgid "Generating key (%d%% done).\n"
msgstr "正在產生金鑰（已完成 %d%%）。\n"

#: lib/random.c:150
msgid "Running in FIPS mode."
msgstr "正在以 FIPS 模式執行。"

#: lib/random.c:156
msgid "Fatal error during RNG initialisation."
msgstr "RNG 初始化期間發生嚴重錯誤。"

#: lib/random.c:194
msgid "Unknown RNG quality requested."
msgstr "要求的 RNG 品質不明。"

#: lib/random.c:199
msgid "Error reading from RNG."
msgstr "從 RNG 讀取時發生錯誤。"

#: lib/setup.c:251
msgid "OPAL support is disabled in libcryptsetup."
msgstr "libcryptsetup 已停用 OPAL 支援。"

#: lib/setup.c:253
#, c-format
msgid "Device %s or kernel does not support OPAL encryption."
msgstr "裝置 %s 或核心不支援 OPAL 加密。"

#: lib/setup.c:269
msgid "Cannot initialize crypto RNG backend."
msgstr "無法初始化加密 RNG 後端。"

#: lib/setup.c:275
msgid "Cannot initialize crypto backend."
msgstr "無法初始化加密後端。"

#: lib/setup.c:308 lib/setup.c:2779 lib/verity/verity.c:109
#, c-format
msgid "Hash algorithm %s not supported."
msgstr "不支援雜湊演算法 %s。"

#: lib/setup.c:311 lib/loopaes/loopaes.c:78
#, c-format
msgid "Key processing error (using hash %s)."
msgstr "金鑰處理錯誤（使用雜湊 %s）。"

#: lib/setup.c:392 lib/setup.c:429
msgid "Cannot determine device type. Incompatible activation of device?"
msgstr "無法判定裝置類型。裝置啟動不相容？"

#: lib/setup.c:398 lib/setup.c:4193
msgid "This operation is supported only for LUKS device."
msgstr "此操作僅支援 LUKS 裝置。"

#: lib/setup.c:435
msgid "This operation is supported only for LUKS2 device."
msgstr "此操作僅支援 LUKS2 裝置。"

#: lib/setup.c:492 lib/luks2/luks2_reencrypt.c:3102
msgid "All key slots full."
msgstr "所有金鑰槽都已滿。"

#: lib/setup.c:503
#, c-format
msgid "Key slot %d is invalid, please select between 0 and %d."
msgstr "金鑰槽 %d 無效，請在 0 到 %d 之間選取。"

#: lib/setup.c:509
#, c-format
msgid "Key slot %d is full, please select another one."
msgstr "金鑰槽 %d 已滿，請選取其他金鑰槽。"

#: lib/setup.c:534 lib/setup.c:3888
msgid "Device size is not aligned to device logical block size."
msgstr "裝置大小未對齊裝置邏輯區塊大小。"

#: lib/setup.c:631
#, c-format
msgid "Header detected but device %s is too small."
msgstr "偵測到標頭，但裝置 %s 太小。"

#: lib/setup.c:672 lib/setup.c:3773 lib/setup.c:5288
#: lib/luks2/luks2_reencrypt.c:3949 lib/luks2/luks2_reencrypt.c:4438
msgid "This operation is not supported for this device type."
msgstr "此操作不支援此裝置類型。"

#: lib/setup.c:677
msgid "Illegal operation with reencryption in-progress."
msgstr "重新加密進行中，此操作不合法。"

#: lib/setup.c:809
msgid "Failed to rollback LUKS2 metadata in memory."
msgstr "無法在記憶體中復原 LUKS2 中繼資料。"

#: lib/setup.c:896 lib/luks1/keymanage.c:241 lib/luks1/keymanage.c:519
#: lib/luks2/luks2_json_metadata.c:1365 src/cryptsetup.c:1780
#: src/cryptsetup.c:1964 src/cryptsetup.c:2019 src/cryptsetup.c:2217
#: src/cryptsetup.c:2362 src/cryptsetup.c:2640 src/cryptsetup.c:2954
#: src/cryptsetup.c:3022 src/utils_reencrypt.c:2310
#: src/utils_reencrypt_luks1.c:1137 tokens/ssh/cryptsetup-ssh.c:72
#, c-format
msgid "Device %s is not a valid LUKS device."
msgstr "裝置 %s 不是有效的 LUKS 裝置。"

#: lib/setup.c:899 lib/luks1/keymanage.c:522
#, c-format
msgid "Unsupported LUKS version %d."
msgstr "不支援的 LUKS 版本 %d。"

#: lib/setup.c:1279
#, c-format
msgid "No known cipher specification pattern detected for active device %s."
msgstr "在啟用中的裝置 %s 上偵測不到已知的加密演算法規格模式。"

#: lib/setup.c:1528 lib/setup.c:3520 lib/setup.c:3612 lib/setup.c:3624
#: lib/setup.c:3796 lib/setup.c:5866
#, c-format
msgid "Device %s is not active."
msgstr "裝置 %s 未啟用。"

#: lib/setup.c:1545
#, c-format
msgid "Underlying device for crypt device %s disappeared."
msgstr "加密裝置 %s 的底層裝置已消失。"

#: lib/setup.c:1627
msgid "Invalid plain crypt parameters."
msgstr "無效的一般加密參數。"

#: lib/setup.c:1632 lib/setup.c:2682
msgid "Invalid key size."
msgstr "無效的金鑰大小。"

#: lib/setup.c:1637 lib/setup.c:2687 lib/setup.c:2892
msgid "UUID is not supported for this crypt type."
msgstr "此加密類型不支援 UUID。"

#: lib/setup.c:1642 lib/setup.c:2692
msgid "Detached metadata device is not supported for this crypt type."
msgstr "此加密類型不支援分離式中繼資料裝置。"

#: lib/setup.c:1652 lib/setup.c:1900 lib/luks2/luks2_reencrypt.c:3035
#: src/cryptsetup.c:1492 src/cryptsetup.c:3761
msgid "Unsupported encryption sector size."
msgstr "不支援的加密磁區大小。"

#: lib/setup.c:1660 lib/setup.c:1929 lib/setup.c:3882
msgid "Device size is not aligned to requested sector size."
msgstr "裝置大小未對齊要求的磁區大小。"

#: lib/setup.c:1712 lib/setup.c:1964 lib/setup.c:2341
msgid "Can't format LUKS without device."
msgstr "沒有裝置就無法格式化 LUKS。"

#: lib/setup.c:1717 lib/setup.c:1969
#, c-format
msgid "Zoned device %s cannot be used for LUKS header."
msgstr "分區型裝置 %s 不能用於 LUKS 標頭。"

#: lib/setup.c:1724 lib/setup.c:1976 lib/setup.c:2347
msgid "Requested data alignment is not compatible with data offset."
msgstr "要求的資料對齊與資料偏移量不相容。"

#: lib/setup.c:1764 lib/setup.c:1994
msgid "WARNING: DAX device can corrupt data as it does not guarantee atomic sector updates.\n"
msgstr "警告：DAX 裝置可能毀損資料，因為它不保證磁區更新具原子性。\n"

#: lib/setup.c:1802 lib/setup.c:2101 lib/setup.c:2122 lib/setup.c:2530
#: lib/setup.c:2577 lib/setup.c:2909
#, c-format
msgid "Cannot wipe header on device %s."
msgstr "無法清除裝置 %s 上的標頭。"

#: lib/setup.c:1815 lib/setup.c:2174
#, c-format
msgid "Device %s is too small for activation, there is no remaining space for data.\n"
msgstr "裝置 %s 太小，無法啟動，已無剩餘空間存放資料。\n"

#: lib/setup.c:1856
msgid "Volume key is too small for encryption with integrity extensions."
msgstr "卷金鑰太小，無法搭配完整性延伸進行加密。"

#: lib/setup.c:1860
msgid "Integrity key size is too small."
msgstr "完整性金鑰大小太小。"

#: lib/setup.c:1869
#, c-format
msgid "Cipher %s-%s (key size %zd bits) is not available."
msgstr "加密演算法 %s-%s（金鑰大小 %zd 位元）無法使用。"

#: lib/setup.c:1910
msgid "WARNING: The device activation will fail, dm-crypt is missing support for requested encryption sector size.\n"
msgstr "警告：裝置啟動將失敗，dm-crypt 缺少對所要求加密磁區大小的支援。\n"

#: lib/setup.c:2104 lib/setup.c:2471 lib/setup.c:2533 lib/utils_device.c:906
#: lib/luks1/keyencryption.c:245 lib/luks2/luks2_reencrypt.c:3074
#: lib/luks2/luks2_reencrypt.c:4498
#, c-format
msgid "Device %s is too small."
msgstr "裝置 %s 太小。"

#: lib/setup.c:2115 lib/setup.c:2154 lib/setup.c:2570 lib/setup.c:2628
#, c-format
msgid "Cannot format device %s in use."
msgstr "無法格式化使用中的裝置 %s。"

#: lib/setup.c:2118 lib/setup.c:2157 lib/setup.c:2573 lib/setup.c:2631
#, c-format
msgid "Cannot format device %s, permission denied."
msgstr "無法格式化裝置 %s，權限不足。"

#: lib/setup.c:2142 lib/setup.c:2600 lib/setup.c:2982
#, c-format
msgid "Cannot format integrity for device %s."
msgstr "無法格式化裝置 %s 的完整性。"

#: lib/setup.c:2161 lib/setup.c:2639
#, c-format
msgid "Cannot format device %s."
msgstr "無法格式化裝置 %s。"

#: lib/setup.c:2204
msgid "Cannot get OPAL alignment parameters."
msgstr "無法取得 OPAL 對齊參數。"

#: lib/setup.c:2216
msgid "Bogus OPAL logical block size."
msgstr "OPAL 邏輯區塊大小無效。"

#: lib/setup.c:2221 lib/luks2/hw_opal/hw_opal.c:305
msgid "Bogus OPAL logical block size differs from device block size."
msgstr "OPAL 邏輯區塊大小與裝置區塊大小不符。"

#: lib/setup.c:2227
msgid "Requested data offset is not compatible with OPAL block size."
msgstr "要求的資料偏移量與 OPAL 區塊大小不相容。"

#: lib/setup.c:2234
msgid "Requested data alignment is not compatible with OPAL alignment."
msgstr "要求的資料對齊與 OPAL 對齊不相容。"

#: lib/setup.c:2254
msgid "Data offset does not satisfy OPAL alignment requirements."
msgstr "資料偏移量不符合 OPAL 對齊需求。"

#: lib/setup.c:2267
msgid "Requested data alignment does not satisfy locking range alignment requirements."
msgstr "要求的資料對齊不符合鎖定範圍的對齊需求。"

#: lib/setup.c:2481
#, c-format
msgid "Compensating device size by %<PRIu64> sectors to align it with OPAL alignment granularity."
msgstr "將裝置大小補償 %<PRIu64> 個磁區，以配合 OPAL 對齊粒度。"

#: lib/setup.c:2541 lib/setup.c:4276 lib/setup.c:4482 lib/utils_wipe.c:356
#: lib/luks2/luks2_json_metadata.c:2734 lib/luks2/luks2_json_metadata.c:3009
#, c-format
msgid "Failed to acquire OPAL lock on device %s."
msgstr "無法在裝置 %s 上取得 OPAL 鎖定。"

#: lib/setup.c:2551
msgid "Incorrect OPAL Admin key."
msgstr "OPAL 管理金鑰不正確。"

#: lib/setup.c:2553
msgid "Cannot setup OPAL segment."
msgstr "無法設定 OPAL 區段。"

#: lib/setup.c:2635
#, c-format
msgid "Cannot format device %s, OPAL device seems to be fully write-protected now."
msgstr "無法格式化裝置 %s，OPAL 裝置目前似乎已完全寫入保護。"

#: lib/setup.c:2637
msgid "This is perhaps a bug in firmware. Run OPAL PSID reset and reconnect for recovery."
msgstr "這可能是韌體中的錯誤。請執行 OPAL PSID 重設並重新連線以復原。"

#: lib/setup.c:2657
#, c-format
msgid "Locking range %d reset on device %s failed."
msgstr "重設裝置 %2$s 上的鎖定範圍 %1$d 失敗。"

#: lib/setup.c:2677
msgid "Can't format LOOPAES without device."
msgstr "沒有裝置就無法格式化 LOOPAES。"

#: lib/setup.c:2722
msgid "Can't format VERITY without device."
msgstr "沒有裝置就無法格式化 VERITY。"

#: lib/setup.c:2733 lib/verity/verity.c:88
#, c-format
msgid "Unsupported VERITY hash type %d."
msgstr "不支援的 VERITY 雜湊類型 %d。"

#: lib/setup.c:2739 lib/verity/verity.c:96
msgid "Unsupported VERITY block size."
msgstr "不支援的 VERITY 區塊大小。"

#: lib/setup.c:2744 lib/verity/verity.c:61
msgid "Unsupported VERITY hash offset."
msgstr "不支援的 VERITY 雜湊偏移量。"

#: lib/setup.c:2749
msgid "Unsupported VERITY FEC offset."
msgstr "不支援的 VERITY FEC 偏移量。"

#: lib/setup.c:2773
msgid "Data area overlaps with hash area."
msgstr "資料區域與雜湊區域重疊。"

#: lib/setup.c:2798
msgid "Hash area overlaps with FEC area."
msgstr "雜湊區域與 FEC 區域重疊。"

#: lib/setup.c:2805
msgid "Data area overlaps with FEC area."
msgstr "資料區域與 FEC 區域重疊。"

#: lib/setup.c:2897
msgid "Integrity key size mismatch."
msgstr "完整性金鑰大小不符。"

#: lib/setup.c:2948
#, c-format
msgid "WARNING: Requested tag size %d bytes differs from %s size output (%d bytes).\n"
msgstr "警告：要求的標籤大小 %d 位元組不同於 %s 的大小輸出（%d 位元組）。\n"

#: lib/setup.c:3061 lib/setup.c:3163
#, c-format
msgid "Unknown or unsupported device type %s requested."
msgstr "要求不明或不支援的裝置類型 %s。"

#: lib/setup.c:3077
#, c-format
msgid "Device %s does not provide inline integrity data fields."
msgstr "裝置 %s 未提供內嵌完整性資料欄位。"

#: lib/setup.c:3083
#, c-format
msgid "Inline tag size %<PRIu32> [bytes] is larger than %<PRIu32> provided by device %s."
msgstr "內嵌標籤大小 %1$<PRIu32> [位元組] 大於裝置 %3$s 提供的 %2$<PRIu32>。"

#: lib/setup.c:3098
#, c-format
msgid "Sector must be the same as device hardware sector (%zu bytes)."
msgstr "磁區必須與裝置硬體磁區相同（%zu 位元組）。"

#: lib/setup.c:3528 lib/setup.c:3617 lib/setup.c:3630
#, c-format
msgid "Unsupported parameters on device %s."
msgstr "裝置 %s 上的參數不受支援。"

#: lib/setup.c:3534 lib/setup.c:3637 lib/luks2/luks2_reencrypt.c:2929
#: lib/luks2/luks2_reencrypt.c:3198 lib/luks2/luks2_reencrypt.c:3595
#, c-format
msgid "Mismatching parameters on device %s."
msgstr "裝置 %s 上的參數不符。"

#: lib/setup.c:3660
msgid "Crypt devices mismatch."
msgstr "加密裝置不符。"

#: lib/setup.c:3692 lib/setup.c:3697 lib/luks2/luks2_reencrypt.c:2413
#: lib/luks2/luks2_reencrypt.c:2945 lib/luks2/luks2_reencrypt.c:4237
#, c-format
msgid "Failed to reload device %s."
msgstr "無法重新載入裝置 %s。"

#: lib/setup.c:3703 lib/setup.c:3709 lib/luks2/luks2_reencrypt.c:2383
#: lib/luks2/luks2_reencrypt.c:2390 lib/luks2/luks2_reencrypt.c:2959
#, c-format
msgid "Failed to suspend device %s."
msgstr "無法暫停裝置 %s。"

#: lib/setup.c:3715 lib/luks2/luks2_reencrypt.c:2397
#: lib/luks2/luks2_reencrypt.c:2980 lib/luks2/luks2_reencrypt.c:4150
#: lib/luks2/luks2_reencrypt.c:4241
#, c-format
msgid "Failed to resume device %s."
msgstr "無法恢復裝置 %s。"

#: lib/setup.c:3730
#, c-format
msgid "Fatal error while reloading device %s (on top of device %s)."
msgstr "重新載入裝置 %s（疊於裝置 %s 之上）時發生嚴重錯誤。"

#: lib/setup.c:3733 lib/setup.c:3735
#, c-format
msgid "Failed to switch device %s to dm-error."
msgstr "無法將裝置 %s 切換為 dm-error。"

#: lib/setup.c:3778
msgid "Can not resize LUKS2 device with static size."
msgstr "無法調整靜態大小的 LUKS2 裝置。"

#: lib/setup.c:3783
msgid "Resize of LUKS2 device with integrity protection is not supported."
msgstr "不支援調整具完整性保護之 LUKS2 裝置的大小。"

#: lib/setup.c:3829
msgid "Cannot resize loop device."
msgstr "無法調整迴圈裝置的大小。"

#: lib/setup.c:3873
msgid "WARNING: Maximum size already set or kernel doesn't support resize.\n"
msgstr "警告：已設定最大大小，或核心不支援調整大小。\n"

#: lib/setup.c:3939
msgid "Resize failed, the kernel doesn't support it."
msgstr "調整大小失敗，核心不支援此操作。"

#: lib/setup.c:3971
msgid "Do you really want to change UUID of device?"
msgstr "確定要變更裝置的 UUID 嗎？"

#: lib/setup.c:4061 lib/setup.c:4069
msgid "Header backup file does not contain compatible LUKS header."
msgstr "標頭備份檔不含相容的 LUKS 標頭。"

#: lib/setup.c:4176
#, c-format
msgid "Volume %s is not active."
msgstr "卷 %s 未啟用。"

#: lib/setup.c:4231
#, c-format
msgid "Volume %s is already suspended."
msgstr "卷 %s 已暫停。"

#: lib/setup.c:4257
#, c-format
msgid "Suspend is not supported for device %s."
msgstr "不支援暫停裝置 %s。"

#: lib/setup.c:4259 lib/setup.c:4267
#, c-format
msgid "Error during suspending device %s."
msgstr "暫停裝置 %s 時發生錯誤。"

#: lib/setup.c:4282
#, c-format
msgid "Device %s was suspended but hardware OPAL device cannot be locked."
msgstr "裝置 %s 已暫停，但無法鎖定硬體 OPAL 裝置。"

#: lib/setup.c:4313 lib/setup.c:4507
#, c-format
msgid "Resume is not supported for device %s."
msgstr "不支援恢復裝置 %s。"

#: lib/setup.c:4315 lib/setup.c:4497 lib/setup.c:4509
#, c-format
msgid "Error during resuming device %s."
msgstr "恢復裝置 %s 時發生錯誤。"

#: lib/setup.c:4351
msgid "Failed to unlink volume key from user specified keyring."
msgstr "無法從使用者指定的鑰匙圈解除連結卷金鑰。"

#: lib/setup.c:4473 lib/setup.c:5653
